# ---------------------------------------------------------------------------
# Bu dosya bir ŞABLONDUR — gerçek secret/parola İÇERMEZ. Kopyalayıp `.env`
# adıyla kaydedin, ardından placeholder'ları kendi (yerel/staging/production)
# değerlerinizle doldurun. `.env` git tarafından izlenmez (bkz. .gitignore).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PostgreSQL (docker-compose bu değerlerle "postgres" servisini oluşturur)
# ---------------------------------------------------------------------------
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=replace-with-postgres-db-name
POSTGRES_PORT=5432

# Uygulama container'ının dışarı açılacağı port
APP_PORT=3000

# Prisma bağlantı dizesi (Docker Compose ile "postgres" servis adını kullanır)
DATABASE_URL="postgresql://replace-with-postgres-user:replace-with-a-strong-random-password@postgres:5432/replace-with-postgres-db-name?schema=public"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-with-a-strong-random-secret
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OpenAI (yapay zeka destekli özellikler için — opsiyonel)
# Doldurup "docker compose up --build" komutunu tekrar çalıştırdığınızda
# AI özellikleri (AI ile görev oluştur / AI özet) aktif olur.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Anthropic Claude (Modül 10 — sosyal/içerik/SEO üretimi için — opsiyonel)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_INPUT_PRICE_PER_MTOK=3
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=15

# ---------------------------------------------------------------------------
# Ortak Alan — gerçek zamanlı işbirliği servisi (Yjs + Hocuspocus)
# ---------------------------------------------------------------------------
COLLAB_SECRET=replace-with-a-strong-random-secret
COLLAB_PORT=1234
# collab container'ının host'ta dışarı açılacağı port (app'ten ayrık tutulur)
COLLAB_HOST_PORT=1234
NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:1234

# ---------------------------------------------------------------------------
# Dosya paylaşımı (§22) — public share link'lerinde şifreli paylaşımların
# görsel erişimini imzalamak için kullanılır. COLLAB_SECRET'tan KASITLI
# olarak ayrıdır — birbirinin yerine kullanılmamalıdır. Eksikse şifreli
# paylaşımların görsel/erişim akışı açıkça hata verir.
# ---------------------------------------------------------------------------
SHARE_SECRET=replace-with-a-strong-random-secret

# ---------------------------------------------------------------------------
# Yerel disk depolama (opsiyonel — belirtilmezse proje kökündeki uploads klasörü kullanılır)
# ---------------------------------------------------------------------------
UPLOADS_DIR=./uploads
